@if(Top)
{
    <div class="topDiv">
        <span class="top">Drinks: @Stats.DrinksCount -</span>
        <span class="top">Alcoholic drinks: @Stats.Alcoholic -</span>
        <span class="top">Non-alcoholic drinks: @Stats.NonAlcoholic</span>
    </div>
}
else
{
    <div>
        <h4>Statistics</h4>
            <span>Drinks: @Stats.DrinksCount</span>
        <br />
            <span>Alcoholic drinks: @Stats.Alcoholic</span>
        <br />
            <span>Non-alcoholic drinks: @Stats.NonAlcoholic</span>
        <br />
            <span>Shots: @Stats.Shots</span>
        <br />
            <span>Cocktails: @Stats.Cocktails</span>
        <br />
            <span>Beers: @Stats.Beer</span>
        <br />
            <span>Ordinary Drinks: @Stats.OrdinaryDrink</span>
        <br />
            <span>Other Drinks: @Stats.Other</span>
        <br />
            <span>Most pop. category: @Stats.MostPopularCategory</span>
        <br />
            <span>Most pop. ingredient: @Stats.MostPopularIngredient</span>
        <br />
    </div>
}




@code {
    [Parameter]
    public Drink[] Drinks { get; set; }
    [Parameter]
    public bool Top { get; set; }

    [Parameter]
    public Statistic Stats { get; set; }
}
