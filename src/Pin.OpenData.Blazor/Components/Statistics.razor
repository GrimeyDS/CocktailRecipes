@typeparam TModel where TModel : Statistic

@if(Stats.GetType().Name == nameof(GraphStatistic))
{
    <div class="graphs">
        @StatisticsInfo
        <Graph Key="Alcoholic" Value="AlcoholicValues" IdName="Alcoholic"></Graph>
        <Graph Key="Category" Value="CategoryValues" IdName="Category"></Graph>
    </div>
}
else if (Stats.GetType().Name == nameof(PopularityStatistic))
{
    <div class="topDiv">
        @StatisticsInfo
        <p><b>Most popular category: </b>@((Stats as PopularityStatistic).MostPopularCategory)</p>
        <p><b>Most popular Ingredient: </b>@((Stats as PopularityStatistic).MostPopularIngredient)</p>
    </div>
}
else
{
    <div class="topDiv">
        <span class="top">Drinks: @Stats.DrinksCount -</span>
        <span class="top">Alcoholic drinks: @Stats.Alcoholic -</span>
        <span class="top">Non-alcoholic drinks: @Stats.NonAlcoholic</span>
    </div>
}


@code {
    [Parameter]
    public TModel Stats { get; set; }

    [Parameter]
    public RenderFragment StatisticsInfo { get; set; }

    private string[] Alcoholic;
    private int[] AlcoholicValues;

    private string[] Category;
    private int[] CategoryValues;

    protected override async Task OnInitializedAsync()
    {
        if (Stats.GetType().Name == (nameof(GraphStatistic)))
        {
            var graphStats = Stats as GraphStatistic;

            Alcoholic = new string[] { nameof(graphStats.Alcoholic), nameof(graphStats.NonAlcoholic) };
            AlcoholicValues = new int[] { graphStats.Alcoholic, graphStats.NonAlcoholic };

            Category = new string[] { nameof(graphStats.Shots), nameof(graphStats.Cocktails), nameof(graphStats.Beer), nameof(graphStats.OrdinaryDrink), nameof(graphStats.Other) };
            CategoryValues = new int[] { graphStats.Shots, graphStats.Cocktails, graphStats.Beer, graphStats.OrdinaryDrink, graphStats.Other };
        }
    }
}
