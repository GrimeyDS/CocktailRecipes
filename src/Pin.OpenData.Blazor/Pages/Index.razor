@page "/"

<PageTitle>Index</PageTitle>

<Newsletter></Newsletter>
<Statistics Top="true" Stats="statistics"></Statistics>

@if(currentDrink == null)
{
    <DrinkList Drinks="allDrinks" OnAdd="AddDrink" OnDelete="DeleteDrink" OnEdit="EditDrink" OnSelect="DetailsDrink"></DrinkList>
}
else if(showDetails)
{
    <DrinkDetails Drink="currentDrink" OnReturn="ReturnToDrinks"></DrinkDetails>
}
else
{
    <DrinkForm Drink="currentDrink" OnSave="SaveDrink" OnReturn="ReturnToDrinks"></DrinkForm>
}



