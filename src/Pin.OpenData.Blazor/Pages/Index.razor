@page "/"

<PageTitle>Index</PageTitle>

<Newsletter></Newsletter>
<Statistics TModel="Statistic" Stats="statistics"></Statistics>

@if(currentDrink == null)
{
    if (confirmDeletion)
    {
        <AlertBox Message="Are you sure you want to delete" OnConfirm="DeleteDrink" OnCancel="Cancel" />
    }
    <DrinkList Drinks="allDrinks" OnAdd="AddDrink" OnDelete="DeleteConfirmation" OnEdit="EditDrink" OnSelect="DetailsDrink"></DrinkList>
}
else if(showDetails)
{
    <DrinkDetails Drink="currentDrink" OnReturn="ReturnToDrinks"></DrinkDetails>
}
else
{
    <DrinkForm Drink="currentDrink" OnSave="SaveDrink" OnReturn="ReturnToDrinks"></DrinkForm>
}



