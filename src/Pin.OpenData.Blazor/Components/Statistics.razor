@inherits DrinksComponentBase

@if(Top)
{
    <div class="topDiv">
        <span class="top">Drinks: @Stats.DrinksCount -</span>
        <span class="top">Alcoholic drinks: @Stats.Alcoholic -</span>
        <span class="top">Non-alcoholic drinks: @Stats.NonAlcoholic</span>
    </div>
}
else
{
    <div class="graphs">
        <h4>Statistics</h4>
        <Graph Key="Alcoholic" Value="AlcoholicValues" IdName="Alcoholic"></Graph>
        <Graph Key="Category" Value="CategoryValues" IdName="Category"></Graph>
    </div>
}




@code {
    [Parameter]
    public bool Top { get; set; }

    [Parameter]
    public Statistic Stats { get; set; }

    private string[] Alcoholic;
    private int[] AlcoholicValues;

    private string[] Category;
    private int[] CategoryValues;

    protected override async Task OnInitializedAsync()
    {
        if (!Top)
        {
            Alcoholic = new string[] { nameof(Stats.Alcoholic), nameof(Stats.NonAlcoholic) };
            AlcoholicValues = new int[] { Stats.Alcoholic, Stats.NonAlcoholic };

            Category = new string[] { nameof(Stats.Shots), nameof(Stats.Cocktails), nameof(Stats.Beer), nameof(Stats.OrdinaryDrink), nameof(Stats.Other) };
            CategoryValues = new int[] { Stats.Shots, Stats.Cocktails, Stats.Beer, Stats.OrdinaryDrink, Stats.Other };
        }
    }
}
